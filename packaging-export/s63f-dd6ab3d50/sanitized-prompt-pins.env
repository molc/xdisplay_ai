# 来自本修订 config/production_behaviour.env.snapshot（总指挥标注无密钥、无环境键）。
# 这是 .21 行为键整表，比提测卡 7 项更长。安装器种子 tmpl 仍只用 author-card-prompt-pins.env。
# 本文件不含 API key / token / DSN 密码。
XDISPLAY_AI_AGENT_RUNTIME_TIMEOUT_SECONDS=1500
XDISPLAY_AI_AUDIT_TOTAL_TIMEOUT_SECONDS=300
XDISPLAY_AI_AUTOFIX_TIMEOUT_S=180
XDISPLAY_AI_BROWSER_SOLVER_ENGINEERING_STYLESHEET_CONTRACT_VERSION=v6
XDISPLAY_AI_BROWSER_SOLVER_MODEL=z-ai/glm-5.2
XDISPLAY_AI_BROWSER_SOLVER_PAGE_HTML_PROMPT_VERSION=v19
XDISPLAY_AI_BROWSER_SOLVER_PROVIDER_PREFS={"ignore":["StreamLake","DigitalOcean"]}
XDISPLAY_AI_BROWSER_SOLVER_REASONING_CONTROL={"reasoning":{"enabled":false}}
XDISPLAY_AI_FIXER_TIMEOUT_S=120
XDISPLAY_AI_IMAGE_GEN_ENABLED=true
XDISPLAY_AI_IMAGE_GEN_TIMEOUT_SECONDS=120
XDISPLAY_AI_INTENT_EXTRACT_TIMEOUT_SECONDS=90
XDISPLAY_AI_LLM_MODE=live
XDISPLAY_AI_LLM_MODEL_AUDIT_PAGE_DRAFT=qwen/qwen3-235b-a22b-2507
XDISPLAY_AI_LLM_MODEL_DEFAULT=qwen/qwen3-235b-a22b-2507
XDISPLAY_AI_LLM_MODEL_INTERPRET_SKETCH=qwen/qwen3-vl-32b-instruct
XDISPLAY_AI_LLM_OPENROUTER_PROVIDER_PREFS={"order":["DeepInfra","Alibaba","Nebius"],"allow_fallbacks":false}
XDISPLAY_AI_LLM_TIMEOUT_SECONDS=1800
XDISPLAY_AI_PROMPT_VERSIONS=planner:v1.2,clarifier:v1.0,diagnoser:v1.0,explainer:v1.0,drafter:v1.0,drafter_dsl:v2.4,sketch_interpreter:v4.0,sketch_interpretation_auditor:v1.0,sketch_layout_auditor:v1.0,auditor_dsl:v1.5,intent_extractor:v2.24,linker_dsl:v1.1,layout_planner:v1.1,component_planner:v1.4,composition_layout_planner:v2.5,component_slot_type_selector:v1.0,component_slot_props_planner:v2.0,page_scene_tweak_planner:v1.0,fixer:v2.2,write_action_declarer:v1.10,nav_declarer:v1.6,engineering_setting_declarer:v1.0,write_action_declarer_link:v1.8,page_set_skeleton_declarer:v1.5,placement_declarer:v1.0,read_display_declarer:v1.15,point_table_column_annotator:v1.1,repeated_series_declarer:v1.2,style_token_declarer:v1.2,strict_region_reader:v1.0,navigation_target_grouping_judge:v1.0
XDISPLAY_AI_RAG_ACTIVE_INDEX_VERSION=v7
XDISPLAY_AI_RAG_BACKEND=pgvector
XDISPLAY_AI_RAG_EMBEDDING_VERSION=bge-m3@1.5
XDISPLAY_AI_SHADOW_STORE_TTL_SECONDS=180
XDISPLAY_AI_SKETCH_VISION_TIMEOUT_SECONDS=90
XDISPLAY_AI_STORE_BACKEND=redis_pg
XDISPLAY_AI_STRICT_SKETCH_RECALL_MAX_WALL_SECONDS=180
XDISPLAY_AI_STRICT_SKETCH_TARGET_ENABLED=true
XDISPLAY_AI_STRICT_SKETCH_VISION_MODEL=qwen3-vl-plus

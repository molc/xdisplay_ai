# s63f 提测卡列出的钉（无密钥）。安装器种子 tmpl 用这一组。
# PAGE_HTML / STYLESHEET 在仓库里是 browser_solver prompt 文件，不是 app/prompts/<role>/ 目录名。
XDISPLAY_AI_PROMPT_VERSIONS=intent_extractor:v2.24,PAGE_HTML:v19,read_display_declarer:v1.15,write_action_declarer:v1.10,write_action_declarer_link:v1.8,sketch_interpreter:v4.0,STYLESHEET:v6
XDISPLAY_AI_BROWSER_SOLVER_PAGE_HTML_PROMPT_VERSION=v19
XDISPLAY_AI_BROWSER_SOLVER_ENGINEERING_STYLESHEET_CONTRACT_VERSION=v6
XDISPLAY_AI_SKETCH_VISION_TIMEOUT_SECONDS=90
# 退役，不得出现：
# XDISPLAY_AI_STAGED_DRAFTER_ENABLED

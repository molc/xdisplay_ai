# Backend environment for the offline package (s70 / prod/s70 61d37700a).
# Only infrastructure and switches that production also sets in .env live here. Behaviour (models, timeouts,
# prompt versions, PAGE_HTML v22, STYLESHEET v7) comes from the backend code defaults, which equal
# config/production_behaviour.env.snapshot - exactly as on .21 (24-869). Do not add behaviour overrides here.
XDISPLAY_AI_ENVIRONMENT={{ENVIRONMENT}}
XDISPLAY_AI_LOG_LEVEL={{LOG_LEVEL}}

XDISPLAY_AI_REDIS_URL=redis://redis:6379/0
XDISPLAY_AI_PG_DSN=postgresql://postgres:postgres@postgres:5432/ai_orchestration
XDISPLAY_AI_EMBEDDING_WORKER_URL=http://embedding-worker:8090
XDISPLAY_AI_SERVER_BASE_URL=http://127.0.0.1:{{APP_HOST_PORT}}

XDISPLAY_AI_LLM_PROVIDER={{LLM_PROVIDER}}
XDISPLAY_AI_LLM_BASE_URL={{LLM_BASE_URL}}
XDISPLAY_AI_TCP_MAXSEG=1167

XDISPLAY_AI_STRICT_SKETCH_EVIDENCE_DIR=/data/strict_probe/evidence
XDISPLAY_AI_STRICT_DESIGN_ASSEMBLY_BINDING_ENABLED=true
XDISPLAY_AI_STRICT_VISION_UPSTREAM=bailian

XDISPLAY_AI_LOG_DIR=/data/logs
XDISPLAY_AI_IMAGE_GEN_OUTPUT_DIR=/data/xdisplay_images
